# EcoQuest configuration — copy to .env and fill in what you need.
# Everything is optional: with no configuration EcoQuest runs fully offline in local demo mode.

# ── AI quiz generation (server-side only — never exposed to the browser) ──────────
# Provider: "anthropic" (default) or "none" to disable.
AI_PROVIDER=anthropic
# Your Anthropic API key. ANTHROPIC_API_KEY is also accepted.
AI_API_KEY=
# Model and effort used for quiz generation.
AI_MODEL=claude-opus-5-5
AI_EFFORT=low

# ── Firebase (optional cloud sync + real leaderboard) ─────────────────────────────
# Leave blank to use local demo mode (localStorage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Advanced ───────────────────────────────────────────────────────────────────────
# Base URL of the quiz API if it is hosted separately from the frontend.
VITE_API_BASE=
# Force the offline question bank even when AI is configured.
VITE_DISABLE_AI=false
# Port for `npm start` (production server).
PORT=3000
